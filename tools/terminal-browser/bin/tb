#!/bin/sh
# tb — terminal-browser, single-line for the rushi tool ABI.
#
# Two calling styles:
#   CLI   : tb <op> [arg1] [arg2]        (human/agent-friendly, one call per line)
#   rushi : stdin  {"op":"open","a":"https://..."}   (route/assembler tool ABI)
#           stdout one JSON object: {"output":...} or {"error":"..."}
#
# Every op is a thin, atomic wrapper around the `terminal-browser` CLI
# (open/ls are terminal-browser subcommands; everything else goes through
# `terminal-browser action -- <...>`).
#
# Ops (a=arg1, b=arg2):
#   open <url>                  open in a browser pane (creates browser if needed)
#   ls                          list this session's browser + tabs
#   goto <url>                  navigate the active tab
#   shot <path.png>            full-page screenshot
#   get <selector> [prop]      element text/content, or innerHTML when prop="html"
#   click <selector>           click by CSS selector (fallback; prefer snapshot refs)
#   pdf <url> [out.pdf]        download a PDF the page renders in its viewer
#   shutdown                    stop the terminal browser
set -eu

TB=terminal-browser
SELF_DIR=$(dirname -- "$0")

out()  { printf '%s' "$1"; }
# In-band error: emit a JSON error object (exit 0 = the wrapper itself ran fine;
# the failure is in-band in the JSON, which the model can read directly).
die()  { printf '{"error":%s}\n' "$(json_escape "error: $1")"; exit 0; }

# JSON-escape a string (backslash, quote, control chars).
json_escape() {
  printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()), end="")'
}

# run a terminal-browser CLI command, capture output, emit a JSON result object
run_cli() {
  # $1 = op name (for messages); rest = terminal-browser args
  op=$1; shift
  errf=$(mktemp)
  rc_out=$("$TB" "$@" 2>"$errf") || { rc=$?; printf '{"error":%s}\n' "$(json_escape "$TB $* -> exit $rc: $(cat "$errf")")"; rm -f "$errf"; return 0; }
  printf '{"output":%s}\n' "$(json_escape "$rc_out")"
  rm -f "$errf"
}

# ---- resolve input -----------------------------------------------------------
if [ ! -t 0 ] && [ ! -e /dev/stdin ]; then args_json=""; fi
if [ -n "${TB_JSON:-}" ]; then
  args_json=$TB_JSON
elif [ ! -t 0 ]; then
  args_json=$(cat)
  case "$args_json" in
    ""|*[![:print:][:space:]]*) args_json="" ;;
  esac
fi

if [ -n "$args_json" ]; then
  # rushi ABI: {"op":"...","a":"...","b":"..."}
  read -r op a b <<JSON
$(printf '%s' "$args_json" | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: d={}
print(d.get("op",""),d.get("a",""),d.get("b",""))
')
JSON
else
  op=$1; shift || true
  a=${1:-}; b=${2:-}
fi
[ -n "$op" ] || die "no op given"

case "$op" in
open)
  [ -n "$a" ] || die "open needs <url>"
  run_cli open open "$a" ;;
ls)
  run_cli ls ls ;;
goto)
  [ -n "$a" ] || die "goto needs <url>"
  run_cli goto action -- open "$a" ;;
shot)
  [ -n "$a" ] || die "shot needs <path.png>"
  run_cli shot action -- screenshot --full "$a" ;;
get)
  [ -n "$a" ] || die "get needs <selector>"
  if [ -n "$b" ] && [ "$b" = html ]; then
    run_cli get action -- get "$a" --inner-html
  else
    run_cli get action -- get "$a"
  fi ;;
click)
  [ -n "$a" ] || die "click needs <selector>"
  run_cli click action -- click "$a" ;;
pdf)
  # Download a PDF from a page whose "Download" button renders the document
  # in an in-page viewer (arXiv, …) instead of transferring the file.
  pdf_url=$a; out=${b:-}
  [ -n "$out" ] || out=./$(basename "$pdf_url")
  case "$out" in */) out="$out$(basename "$pdf_url")" ;; esac
  outdir=$(dirname -- "$out"); [ -d "$outdir" ] || mkdir -p "$outdir"
  cdp_port=""
  if command -v node >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    cdp_port=$("$TB" ls --json 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
for b in d.get("browsers",[]):
    if b.get("cdpPort"): print(b["cdpPort"]); break
' 2>/dev/null || true)
  fi
  if [ -n "$cdp_port" ]; then
    host=$(python3 -c 'import urllib.parse,sys;print(urllib.parse.urlparse(sys.argv[1]).netloc)' "$pdf_url" 2>/dev/null || true)
    tmpdl=$(mktemp -d)
    cderr=$(mktemp)
    got=$(node "$SELF_DIR/cdp-download.mjs" "$cdp_port" "$host" "$pdf_url" "$tmpdl" 2>"$cderr") || rc_cdp=$?
    if [ -n "$got" ] && [ -f "$got" ]; then
      mv -f "$got" "$out"
      rm -rf "$tmpdl" "$cderr"
      printf '{"output":%s}\n' "$(json_escape "Download saved to $out")"
      exit 0
    fi
    rm -rf "$tmpdl"
    printf 'warning: CDP download path unavailable, trying viewer button (cdp err: %s)\n' "$(head -c 300 "$cderr")" >&2
    rm -f "$cderr"
  fi
  # fallback: the viewer's own Download button (works without Node/CDP)
  ref=""
  i=0
  while [ "$i" -lt 20 ]; do
    ref=$("$TB" action -- snapshot 2>/dev/null | sed -n 's/.*button "Download" \[ref=\(e[0-9][0-9]*\)\].*/\1/p' | sed -n 1p)
    [ -n "$ref" ] && break
    i=$((i+1)); sleep 1
  done
  if [ -n "$ref" ]; then
    if "$TB" action -- download "@$ref" "$out" >/dev/null 2>&1; then
      printf '{"output":%s}\n' "$(json_escape "Download saved to $out")"
      exit 0
    fi
    die "viewer download failed"
  fi
  die "no download path found on page (viewer Download button not found; CDP unavailable?)" ;;
shutdown)
  run_cli shutdown shutdown ;;
*)
  die "unknown op '$op' (open|ls|goto|shot|get|click|pdf|shutdown)" ;;
esac
